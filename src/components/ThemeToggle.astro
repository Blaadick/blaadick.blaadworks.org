<button id="theme-toggle" class="control button" type="button" aria-label="Switch color scheme">
    <svg data-icon="system" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4"></path>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.9 4.9 1.4 1.4"></path>
        <path d="m17.7 17.7 1.4 1.4"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.3 17.7-1.4 1.4"></path>
        <path d="m19.1 4.9-1.4 1.4"></path>
    </svg>
    <svg data-icon="dark" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
    <svg data-icon="light" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
</button>

<script>
    import {setupCycleToggle} from '../scripts/cycle-toggle';

    const THEMES = ['system', 'dark', 'light'];
    const root = document.documentElement;

    setupCycleToggle('theme-toggle', 'theme', THEMES, (theme) => {
        if(theme === 'system') delete root.dataset.theme;
        else root.dataset.theme = theme;
    });
</script>
