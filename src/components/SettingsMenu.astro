---
import BackgroundToggle from './BackgroundToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<div id="settings-menu" class="settings">
    <div class="items">
        <LanguageToggle/>
        <ThemeToggle/>
        <BackgroundToggle/>
    </div>
    <button id="settings-toggle" class="control button" type="button" aria-label="Settings" aria-expanded="false" aria-controls="settings-menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
            <circle cx="12" cy="12" r="3"></circle>
        </svg>
    </button>
</div>

<style>
    .settings,
    .items {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .items > :global(.control) {
        width: 36px;
        height: 36px;
    }

    .items :global(svg) {
        width: 16px;
        height: 16px;
    }

    .items > :global(*) {
        opacity: 0;
        visibility: hidden;
        transform: translateY(16px) scale(0.8);
        transition: opacity 0.2s ease-out,
        transform 0.2s ease-out,
        visibility 0.2s,
        background-color 0.15s ease-out,
        border-color 0.15s ease-out;
    }

    .settings.open .items > :global(*) {
        opacity: 1;
        visibility: visible;
        transform: none;
    }

    .settings.open .items > :global(:nth-child(2)) {
        transition-delay: 0.04s, 0.04s, 0s, 0s, 0s;
    }

    .settings.open .items > :global(:nth-child(1)) {
        transition-delay: 0.08s, 0.08s, 0s, 0s, 0s;
    }

    #settings-toggle svg {
        transition: transform 0.3s ease-out;
    }

    .settings.open #settings-toggle svg {
        transform: rotate(90deg);
    }

    @media (prefers-reduced-motion: reduce) {
        .items > :global(*),
        #settings-toggle svg {
            transition: none;
        }
    }
</style>

<script>
    const menu = document.getElementById('settings-menu')!;
    const toggle = document.getElementById('settings-toggle')!;

    toggle.addEventListener('click', () => {
        const open = menu.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
    });
</script>
