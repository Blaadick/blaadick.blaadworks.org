---
import DotsBackground from "../components/DotsBackground.astro";
import SettingsMenu from "../components/SettingsMenu.astro";
import StreaksBackground from "../components/StreaksBackground.astro";
import TunnelBackground from "../components/TunnelBackground.astro";

interface Props {
    title?: string;
    description?: string;
}

const {title = "Blaadick", description = "Blaadick\'s personal site: toys, experiments and small pages."} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            name: "Blaadick",
            url: Astro.site,
        },
        {
            "@type": "Person",
            name: "Blaadick",
            url: Astro.site,
            sameAs: [
                "https://github.com/Blaadick",
                "https://www.youtube.com/@blaadick",
                "https://www.twitch.tv/blaadick",
                "https://www.patreon.com/cw/blaadick",
                "https://modrinth.com/user/Blaadick"
            ],
        },
    ],
};
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <meta name="author" content="Blaadick"/>
    <link rel="canonical" href={canonical}/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Blaadick"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}/>
    <script is:inline>
        document.documentElement.dataset.background = localStorage.getItem("background") ?? "streaks";
        const theme = localStorage.getItem("theme");
        if(theme === "dark" || theme === "light") document.documentElement.dataset.theme = theme;
        document.addEventListener("contextmenu", (event) => event.preventDefault());
        document.addEventListener("pointerdown", (event) => {
            const button = event.button === 0 && event.target.closest(".button");
            if(!button) return;
            button.classList.add("pressed");
            const release = () => button.classList.remove("pressed");
            document.addEventListener("pointerup", release, {once: true});
            document.addEventListener("pointercancel", release, {once: true});
        });
    </script>
</head>
<body>
<StreaksBackground/>
<DotsBackground/>
<TunnelBackground/>
<div class="controls">
    <SettingsMenu/>
</div>
<slot/>
</body>
</html>

<style is:global>
    :root {
        color-scheme: light dark;
        --bg: light-dark(#e5e5e5, #000000);
        --fg: light-dark(#161616, #f0f0f0);
        --card: light-dark(#f5f5f5, #141414);
        --card-border: light-dark(#d6d6d6, #2a2a2a);
        --accent: light-dark(#6025c4, #b56cff);
        --streak: light-dark(rgb(96 37 196 / 0.9), #b56cff);
    }

    :root[data-theme="light"] {
        color-scheme: light;
    }

    :root[data-theme="dark"] {
        color-scheme: dark;
    }

    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }

    .controls {
        position: fixed;
        bottom: 16px;
        right: 16px;
        z-index: 1;
        display: flex;
        gap: 12px;
    }

    .control {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        cursor: pointer;
    }

    .button {
        border: 1px solid var(--card-border);
        background-color: color-mix(in srgb, var(--fg) 4%, var(--card));
        color: var(--fg);
        transition: background-color 0.15s ease-out,
        border-color 0.15s ease-out;
    }

    .button:hover {
        background-color: color-mix(in srgb, var(--fg) 7%, var(--card));
        border-color: color-mix(in srgb, var(--fg) 20%, var(--card));
    }

    .button.pressed {
        background-color: color-mix(in srgb, var(--fg) 10%, var(--card));
        border-color: color-mix(in srgb, var(--fg) 25%, var(--card));
    }

    body {
        font-family: system-ui, sans-serif;
        background: var(--bg);
        color: var(--fg);
    }
</style>
